# 凭据与开关模板 —— 值全部留空，只有键名。
# 用法：拷成 $PT_SESSIONS_DIR/.env（默认 ~/.pt-sessions/.env），chmod 600，再逐行填。
# 只需要填你**实际会签到**的站；没用到的站留空即可，脚本不会去碰。

# ── 目录约定（一般不用改）────────────────────────────────────────
# PT_SESSIONS_DIR=/your/path/.pt-sessions   # 会话/cookie/状态目录；默认 ~/.pt-sessions
# HERMES_HOME=/your/path/.hermes            # Hermes 主目录；默认 ~/.hermes

# ── 代理：仅教育网（BYR）必须凭代理访问，其余站点一律直连 ──────
# 注意：PT 站点签到**绝不能走境外代理**，会触发风控甚至封号；
#      这里的代理只给 BYR 这一个站用（教育网直连不通才需要）。
# BYR_PROXY=http://127.0.0.1:7890
# BYR_PROFILE=default

# ── M-Team（唯一需要 2FA 的站）─────────────────────────────────
MTEAM_USERNAME=
MTEAM_PASSWORD=
MTEAM_TOTP_SECRET=
MTEAM_SITE=https://kp.m-team.cc
MTEAM_LOGIN_URL=
MTEAM_HOME_URL=
MTEAM_PROFILE=default

# 2FA 走邮箱取验证码时（与 TOTP 二选一）
MTEAM_EMAIL_USER=
MTEAM_EMAIL_APP_PASSWORD=
MTEAM_EMAIL_IMAP_HOST=
MTEAM_EMAIL_IMAP_PORT=993
MTEAM_EMAIL_TO=
MTEAM_EMAIL_CODE_TIMEOUT=180

# ── U2（教育网，需人工过验证码）───────────────────────────────
U2_EMAIL=
U2_PASSWORD=

# ── CNLang ─────────────────────────────────────────────────────
CNLANG_USERNAME=
CNLANG_PASSWORD=
CNLANG_SITE=
CNLANG_LOGIN_URL=

# ── 其余站点的 cookie / 开关 ───────────────────────────────────
WS_COOKIE=
HTPT_COOKIE=
DISCFAN_COOKIE=
HT_USER=
PIGGO_2FA=
SP_2FA=

# ── 朱雀（策略参数，可留默认）──────────────────────────────────
# ZQ_TARGET=  ZQ_STAGE=  ZQ_POOL=  ZQ_DRY=1  ZQ_FLOOR=  ZQ_MAX_LV=
# ZQ_MAX_DRAWS=  ZQ_BUFF_GAP_H=

# ── 通知落点（可选）────────────────────────────────────────────
# MTEAM_FEISHU_WEBHOOK=
# MTEAM_TELEGRAM_TO=
# MTEAM_TELEGRAM_CMD=
